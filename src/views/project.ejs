<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>

  <p><%= project.description %></p>

  <p>
    <strong>Date:</strong>
    <%= new Date(project.project_date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric'
    }) %>
  </p>

  <p><strong>Location:</strong> <%= project.location %></p>

  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>

  <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
    <section>
      <h2>Categories</h2>
      <ul class="tags">
        <% categories.forEach(category => { %>
          <li>
            <a href="/category/<%= category.category_id %>"><%= category.name %></a>
          </li>
        <% }); %>
      </ul>
    </section>
  <% } %>
       <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a> 
       <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
</main>

<%- include('partials/footer') %>